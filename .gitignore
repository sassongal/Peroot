# OS
.DS_Store

# Environment files
.env*

# Node / package
**/node_modules
**/.pnp
**/.pnp.*

# Next.js / build
**/.next
**/out
**/build
**/.turbo

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/.pnpm-debug.log*

# Vercel
**/.vercel

# Git worktrees (local clone paths; not part of the app)
.worktrees/

# Misc
.qodo/
Prut/web/.git.bak/
.vscode/
*.code-workspace

# Python tooling (crewai-ui-audit and similar helper tools)
**/.venv/
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/

# Absolute-path leakage artifacts from tools that wrote to $HOME
# instead of cwd (e.g., a previous crewai run created a recursive
# Users/galsasson/Peirutech/... nesting inside the tool dir).
Prut/web/tools/*/Users/

# IDE and tool caches (local per-dev state, not for the repo)
**/.cursor/
**/.opencode/
**/.playwright-mcp/

# MCP server build output
peroot-mcp-server/dist/

# Windows PowerShell redirect artifact (> NUL creates a literal "nul" file)
**/nul

# Local AI tooling config — contains secrets (MCP tokens etc.); never commit
.mcp.json
**/.mcp.json

# .claude/ — version the SHARED agent config (slash commands, subagents, the
# non-secret settings.json) so every worktree and machine gets the same setup.
# Everything else under .claude/ is local state or holds tokens: settings.local.json
# carries live API keys, worktrees/ is machine-specific. Keep those out.
.claude/*
**/.claude/*
!.claude/commands/
!.claude/agents/
!.claude/settings.json
!**/.claude/commands/
!**/.claude/agents/
!**/.claude/settings.json

# Generated knowledge-graph output from the `graphify` skill (regenerate on demand).
# Note the `src/` copy: it must never be committed, it would be type-checked and linted.
graphify-out/
**/graphify-out/

# Scratch screenshots from blog design comparison (not repo assets)
Prut/web/*.png
