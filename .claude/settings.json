{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Root-session config for the Peroot monorepo. Mirrors Prut/web/.claude/settings.json so sessions started at the repo root get the same permissions and the impeccable design-detector hook.",
  "env": { "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1" },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci*)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(node *)",
      "Bash(vercel *)",
      "WebSearch",
      "WebFetch",
      "mcp__supabase__execute_sql",
      "mcp__supabase__list_tables",
      "mcp__supabase__get_advisors",
      "mcp__github__get_file_contents",
      "mcp__github__list_pull_requests",
      "mcp__plugin_vercel_vercel__list_deployments",
      "mcp__plugin_vercel_vercel__get_deployment_build_logs"
    ],
    "additionalDirectories": ["C:/Users/sasso/dev/Peroot/peroot-mcp-server"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/Users/sasso/.claude/skills/impeccable/scripts/hook.mjs\"",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ]
  }
}
